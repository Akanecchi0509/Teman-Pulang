```xml
<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Tema utama aplikasi (Material 3, tanpa ActionBar bawaan) -->
    <style name="Theme.TemenPulang" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/tp_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/tp_primary_light</item>
        <item name="colorOnPrimaryContainer">@color/tp_primary_dark</item>
        <item name="colorSecondary">@color/tp_secondary</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSecondaryContainer">@color/tp_primary_light</item>
        <item name="colorOnSecondaryContainer">@color/tp_primary_dark</item>
        <item name="colorSurface">@color/tp_surface</item>
        <item name="colorOnSurface">@color/tp_text_primary</item>
        <item name="colorError">@color/tp_error</item>
        <item name="android:colorBackground">@color/tp_background</item>
        <item name="android:statusBarColor">@color/tp_background</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- Card: sudut membulat, garis tipis, tanpa bayangan berat -->
    <style name="Widget.TemenPulang.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/tp_surface</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/tp_divider</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- Tombol utama (terisi) -->
    <style name="Widget.TemenPulang.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">28dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Tombol sekunder (garis luar) -->
    <style name="Widget.TemenPulang.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">28dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Gaya teks -->
    <style name="TextAppearance.TemenPulang.Headline" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/tp_text_primary</item>
    </style>

    <style name="TextAppearance.TemenPulang.Title" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/tp_text_primary</item>
    </style>

    <style name="TextAppearance.TemenPulang.Value" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/tp_text_primary</item>
    </style>

    <style name="TextAppearance.TemenPulang.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/tp_text_secondary</item>
    </style>

    <style name="TextAppearance.TemenPulang.Label" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/tp_text_secondary</item>
    </style>

</resources>
```